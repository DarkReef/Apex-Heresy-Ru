    "system": {
      "availability": "very-rare",
      "weight": 2,
      "description": "<div class='bc-entry'><p class='bc-lead'>Synskin is a bio-reactive body glove with an inert non-reflective surface that moulds itself to the wearers form.</p><div class='bc-rule'><p>It grants 2 Armour Points to all locations not already armoured and the wearer gains a +10 bonus to Stealth Tests. It also renders the wearer invisible to the use of infra-red goggles and Dark Sight.</p></div></div>",
      "source": "Only War, p. 198 (Table 6-20), p. 198"
    },
