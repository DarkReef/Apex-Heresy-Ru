[
  {
    "name": "Chameleoline Cloak",
    "type": "gear",
    "folder": "Gear",
    "img": "systems/dark-heresy/assets/icons/equipment/cameleoline-cloak.webp",
    "system": {
      "availability": "rare",
      "weight": 0.5,
      "description": "<div class='bc-entry'><p class='bc-lead'>Chameleoline material is made up of mimic fibres that blend the coloration of the wearer into their surroundings and are the garb of choice for snipers.</p><div class='bc-rule'><p>A character wearing a chameleoline cloak gains a +20 bonus to Stealth Tests. If the wearer remains stationary, any Ballistic Skill Tests to target him suffer a –30 penalty.</p></div></div>",
      "source": "Only War, p. 198 (Table 6-20), p. 197"
    },
    "effects": [
