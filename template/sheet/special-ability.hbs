<form class="{{cssClass}}" autocomplete="off">
    <div class="header border">
        <div class="flex row">
            <div class="avatar">
                <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
            </div>
            <div class="flex column grow justify-center">
                <div class="name header-row">
                    <label>{{localize "SPECIAL_ABILITY.NAME"}}</label>
                    <input name="name" type="text" value="{{item.name}}" />
                </div>
            </div>
        </div>
    </div>

    <div class="sheet-tabs tabs flex row" data-group="primary">
        <b class="item" data-tab="notes">{{localize "TAB.NOTES"}}</b>
        <b class="item" data-tab="data">{{localize "TAB.DATA"}}</b>
        <b class="item" data-tab="effects">{{localize "TAB.EFFECTS"}}</b>
    </div>

    <div class="sheet-body">
        <div class="tab" data-group="primary" data-tab="data">
            <div class="stats border">
                <h1>{{localize "TITLE.STATS"}}</h1>
                {{!-- Same conversion as trait.hbs: one row shape across all item sheets. --}}
                <div class="form-group">
                    <label>{{localize "SPECIAL_ABILITY.BENEFIT"}}</label>
                    <div class="form-fields">
                        <input name="system.benefit" type="text" value="{{system.benefit}}" />
                    </div>
                </div>
                {{!-- Режим Deathwatch: у одиночных способностей книга печатает ранг,
                      у отрядных — цену Единства (стр. 216, 221). --}}
                <div class="form-group">
                    <label>{{localize "SPECIAL_ABILITY.MODE"}}</label>
                    <div class="form-fields">
                        <select name="system.mode">
                            {{selectOptions (config "abilityModes") selected=system.mode localize=true}}
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SPECIAL_ABILITY.REQUIRED_RANK"}}</label>
                    <div class="form-fields">
                        <input name="system.requiredRank" type="number" value="{{system.requiredRank}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "SPECIAL_ABILITY.COHESION_COST"}}</label>
                    <div class="form-fields">
                        <input name="system.cohesionCost" type="number" value="{{system.cohesionCost}}" data-dtype="Number" />
                    </div>
                </div>
                <div class="form-group">
                    <label>{{localize "TALENT.COST"}}</label>
                    <div class="form-fields">
                        <input name="system.cost" type="number" value="{{system.cost}}" data-dtype="Number" />
                    </div>
                </div>
            </div>
        </div>
        <div class="tab" data-group="primary" data-tab="effects">
            {{> systems/apex-heresy-ru/template/sheet/item/effects.hbs}}
        </div>
        <div class="tab" data-group="primary" data-tab="notes">
            <div class="notes-editor border">
                <h1>{{localize "TITLE.NOTES"}}</h1>
                <div class="notes-editor-body">
                    {{editor enrichment.system.description target="system.description" engine="prosemirror" button=true owner=owner editable=editable}}
                </div>
            </div>
        </div>
    </div>
</form>