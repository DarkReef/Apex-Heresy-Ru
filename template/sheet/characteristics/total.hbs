<div class="total-wrapper">
    <input class="total dh-modifier-total" type="number" value="{{characteristic.displayTotal}}" data-dtype="Number" readonly
           title="{{characteristic.modifierTooltip}}" data-tooltip="{{characteristic.modifierTooltipHtml}}" aria-label="{{characteristic.modifierTooltip}}" />
    <input class="temp-modifier" name="system.characteristics.{{key}}.tempModifier" type="number" value="{{lookup (lookup @root.source.characteristics key) 'tempModifier'}}" data-dtype="Number" placeholder="±" />
</div>
